# Прод-стенд Burndown Tracker (docker-compose.yml).
#   cp .env.example .env && openssl rand -hex 32   # вписать в SECRET_KEY
# Ключ фиксированный: короче 32 символов приложение отвергает (генерирует свой случайный).

SECRET_KEY=замените-это-ключом-openssl-rand-hex-32

# Публикация стенда
HTTP_PORT=39667
# HTTP_BIND=127.0.0.1   # только localhost, если стенд не нужен в локальной сети

TZ=Europe/Moscow
